# Torch is pinned to the CPU-only build (+cpu) served from the PyTorch index.
# The default PyPI linux wheel bundles CUDA libraries (>2 GB); the +cpu build
# keeps the image small. The local-version suffix guarantees pip/uv can only
# resolve it from https://download.pytorch.org/whl/cpu.
torch==2.7.1+cpu
